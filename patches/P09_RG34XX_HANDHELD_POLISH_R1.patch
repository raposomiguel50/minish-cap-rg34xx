diff --git a/port/port_bios.c b/port/port_bios.c
index c27cad6..cfa34dc 100644
--- a/port/port_bios.c
+++ b/port/port_bios.c
@@ -67,6 +67,14 @@ static bool gQuitRequested = false;
 static bool sFastForward = false;
 static int sFrameNum = 0;
 
+/* RG34XX-specific behavior is opt-in from the PortMaster launcher so the
+ * generic desktop/Android/other-handheld builds retain their existing input
+ * contract. muOS exposes the physical MENU key as SDL gamepad GUIDE. */
+static bool Port_IsRg34xxHandheld(void) {
+    const char* v = getenv("TMC_RG34XX_HANDHELD");
+    return v != NULL && v[0] == '1';
+}
+
 /* Soft-reset re-entry. AgbMain arms this with setjmp() at the top of the
  * game loop; SoftReset() longjmp()s back to re-run AgbMain's init (which
  * RegisterRamResets everything except EWRAM, preserving save data) — the
@@ -485,6 +493,17 @@ static void Port_PumpEvents(void) {
             const bool is_down = (e.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN);
             const bool is_up = (e.type == SDL_EVENT_GAMEPAD_BUTTON_UP);
             if (is_down || is_up) {
+                /* RG34XX MENU -> direct application exit. The binary returns
+                 * normally to the PortMaster launcher, which then executes
+                 * pm_finish and restores muOS. This is deliberately gated by
+                 * TMC_RG34XX_HANDHELD so GUIDE keeps its generic behavior on
+                 * other targets. */
+                if (is_down && e.gbutton.button == SDL_GAMEPAD_BUTTON_GUIDE && Port_IsRg34xxHandheld()) {
+                    fprintf(stderr, "[rg34xx] MENU pressed: returning to muOS.\n");
+                    gQuitRequested = true;
+                    continue;
+                }
+
                 if (e.gbutton.button == SDL_GAMEPAD_BUTTON_BACK)
                     s_select_held = is_down;
                 if (e.gbutton.button == SDL_GAMEPAD_BUTTON_START)
