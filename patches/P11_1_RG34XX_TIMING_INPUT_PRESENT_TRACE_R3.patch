+/* P11.1 RG34XX instrumentation only. Buffered /tmp trace minimizes observer effect. */
+static int sP11TraceEnabled = -1;
+static FILE* sP11TraceFile = NULL;
+static char sP11TraceBuffer[262144];
+static u64 sP11TraceLastFlushNs = 0;
+static u64 sP11TickSeq = 0;
+static u64 sP11PresentSeq = 0;
+static u64 sP11InputSeq = 0;
+static u64 sP11EventSeq = 0;
+static u64 sP11LastEventSeq = 0;
+static u64 sP11LastEventDequeueNs = 0;
+static u64 sP11LastEventSdlNs = 0;
+
+static bool Port_P11TraceEnabled(void) {
+    if (sP11TraceEnabled < 0) {
+        const char* e = getenv("TMC_P11_TRACE");
+        sP11TraceEnabled = (e && *e && e[0] != '0') ? 1 : 0;
+    }
+    return sP11TraceEnabled != 0;
+}
+
+static FILE* Port_P11TraceGetFile(void) {
+    if (!Port_P11TraceEnabled())
+        return NULL;
+    if (sP11TraceFile)
+        return sP11TraceFile;
+    const char* path = getenv("TMC_P11_TRACE_PATH");
+    if (!path || !*path)
+        path = "/tmp/minishcap-p11-trace.tsv";
+    sP11TraceFile = fopen(path, "wb");
+    if (!sP11TraceFile) {
+        sP11TraceEnabled = 0;
+        return NULL;
+    }
+    setvbuf(sP11TraceFile, sP11TraceBuffer, _IOFBF, sizeof(sP11TraceBuffer));
+    fprintf(sP11TraceFile, "#P11TRACE\t1\n");
+    fprintf(sP11TraceFile, "M\t%llu\tP10.3.2\t59.7275\t119.455\t1920\n",
+            (unsigned long long)SDL_GetTicksNS());
+    return sP11TraceFile;
+}
+
+static void Port_P11Trace(const char* fmt, ...) {
+    FILE* f = Port_P11TraceGetFile();
+    if (!f)
+        return;
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(f, fmt, ap);
+    va_end(ap);
+    u64 now = SDL_GetTicksNS();
+    if (sP11TraceLastFlushNs == 0 || now - sP11TraceLastFlushNs >= 1000000000ULL) {
+        fflush(f);
+        sP11TraceLastFlushNs = now;
+    }
+}
+
+static void Port_P11TraceEvent(const SDL_Event* e) {
+    if (!Port_P11TraceEnabled() || !e)
+        return;
+    const char* kind = NULL;
+    int control = -1;
+    int value = 0;
+    u64 sdlTs = 0;
+    if (e->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN || e->type == SDL_EVENT_GAMEPAD_BUTTON_UP) {
+        kind = "BTN";
+        control = (int)e->gbutton.button;
+        value = (e->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) ? 1 : 0;
+        sdlTs = (u64)e->gbutton.timestamp;
+    } else if (e->type == SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+        kind = "AXIS";
+        control = (int)e->gaxis.axis;
+        value = (int)e->gaxis.value;
+        sdlTs = (u64)e->gaxis.timestamp;
+    } else {
+        return;
+    }
+    u64 deq = SDL_GetTicksNS();
+    u64 seq = ++sP11EventSeq;
+    sP11LastEventSeq = seq;
+    sP11LastEventDequeueNs = deq;
+    sP11LastEventSdlNs = sdlTs;
+    Port_P11Trace("E\t%llu\t%llu\t%llu\t%llu\t%s\t%d\t%d\n",
+                  (unsigned long long)seq,
+                  (unsigned long long)deq,
+                  (unsigned long long)sdlTs,
+                  (unsigned long long)sP11TickSeq,
+                  kind, control, value);
+}
+
+static void Port_P11TraceInputCommit(u16 keyinput) {
+    if (!Port_P11TraceEnabled())
+        return;
+    u64 now = SDL_GetTicksNS();
+    u64 seq = ++sP11InputSeq;
+    Port_P11Trace("I\t%llu\t%llu\t%llu\t%04x\t%llu\t%llu\t%llu\n",
+                  (unsigned long long)seq,
+                  (unsigned long long)now,
+                  (unsigned long long)sP11TickSeq,
+                  (unsigned)keyinput,
+                  (unsigned long long)sP11LastEventSeq,
+                  (unsigned long long)sP11LastEventDequeueNs,
+                  (unsigned long long)sP11LastEventSdlNs);
+}
