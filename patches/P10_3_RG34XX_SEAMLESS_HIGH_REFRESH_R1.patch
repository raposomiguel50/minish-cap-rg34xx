+static bool sRgGuideHeld=false;
+static bool sRgL2Held=false;
+static bool sRgR2Held=false;
+static bool sRgExitLatch=false;
+static bool sRgSettingsLatch=false;
+
+static bool Port_RG34XX_HandleSystemEvent(const SDL_Event* e) {
+    if (!Port_RG34XX_Seamless() || !e)
+        return false;
+
+    if (e->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ||
+        e->type == SDL_EVENT_GAMEPAD_BUTTON_UP) {
+        const bool down=e->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN;
+        if (e->gbutton.button == SDL_GAMEPAD_BUTTON_GUIDE)
+            sRgGuideHeld=down;
+
+        /* MENU+X/Y are horizontal navigation only while settings are open.
+         * Outside settings they are simply reserved/consumed; they never
+         * trigger an original-GBA action or a soft-slot. */
+        if (down && sRgGuideHeld &&
+            e->gbutton.button == SDL_GAMEPAD_BUTTON_WEST) {
+            if (Port_DebugMenu_IsOpen()) {
+                Port_ImGui_RG34XXPulseHorizontal(-1);
+                fprintf(stderr,"[rg34xx] settings-nav=left\n");
+            }
+            return true;
+        }
+        if (down && sRgGuideHeld &&
+            e->gbutton.button == SDL_GAMEPAD_BUTTON_NORTH) {
+            if (Port_DebugMenu_IsOpen()) {
+                Port_ImGui_RG34XXPulseHorizontal(+1);
+                fprintf(stderr,"[rg34xx] settings-nav=right\n");
+            }
+            return true;
+        }
+    }
+
+    if (e->type == SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+        const bool pressed=e->gaxis.value > 16384;
+        if (e->gaxis.axis == SDL_GAMEPAD_AXIS_LEFT_TRIGGER)
+            sRgL2Held=pressed;
+        if (e->gaxis.axis == SDL_GAMEPAD_AXIS_RIGHT_TRIGGER)
+            sRgR2Held=pressed;
+    }
+
+    if (!(sRgGuideHeld && sRgL2Held))
+        sRgExitLatch=false;
+    if (!(sRgGuideHeld && sRgR2Held))
+        sRgSettingsLatch=false;
+
+    if (sRgGuideHeld && sRgL2Held && !sRgExitLatch) {
+        sRgExitLatch=true;
+        fprintf(stderr,"[rg34xx] MENU+L2: returning to muOS.\n");
+        gQuitRequested=true;
+        return true;
+    }
+
+    if (sRgGuideHeld && sRgR2Held && !sRgSettingsLatch) {
+        sRgSettingsLatch=true;
+        Port_DebugMenu_Toggle();
+        fprintf(stderr,"[rg34xx] MENU+R2: settings=%s\n",
+                Port_DebugMenu_IsOpen() ? "open" : "closed");
+        return true;
+    }
+
+    /* MENU itself is a modifier, not a gameplay input. */
+    if ((e->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ||
+         e->type == SDL_EVENT_GAMEPAD_BUTTON_UP) &&
+        e->gbutton.button == SDL_GAMEPAD_BUTTON_GUIDE)
+        return true;
+
+    return false;
+}
