+static bool Port_RG34XX_SeamlessUi(void) {
+    const char* e = getenv("TMC_RG34XX_SEAMLESS");
+    return e && *e && e[0] != '0';
+}
+
+extern "C" bool Port_ImGui_HandleRG34XXNav(const SDL_Event* event) {
+    if (!Port_RG34XX_SeamlessUi() || !sImGuiInited || !Port_DebugMenu_IsOpen() || !event)
+        return false;
+
+    ImGuiIO& io = ImGui::GetIO();
+
+    if (event->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ||
+        event->type == SDL_EVENT_GAMEPAD_BUTTON_UP) {
+        const bool down = event->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN;
+        switch ((SDL_GamepadButton)event->gbutton.button) {
+            case SDL_GAMEPAD_BUTTON_WEST:  /* RG34XX X */
+                io.AddKeyEvent(ImGuiKey_Enter, down);
+                return true;
+            case SDL_GAMEPAD_BUTTON_NORTH: /* RG34XX Y */
+                io.AddKeyEvent(ImGuiKey_Escape, down);
+                return true;
+
+            /* Original GBA controls never navigate port settings. */
+            case SDL_GAMEPAD_BUTTON_SOUTH:
+            case SDL_GAMEPAD_BUTTON_EAST:
+            case SDL_GAMEPAD_BUTTON_BACK:
+            case SDL_GAMEPAD_BUTTON_START:
+            case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER:
+            case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER:
+            case SDL_GAMEPAD_BUTTON_DPAD_UP:
+            case SDL_GAMEPAD_BUTTON_DPAD_DOWN:
+            case SDL_GAMEPAD_BUTTON_DPAD_LEFT:
+            case SDL_GAMEPAD_BUTTON_DPAD_RIGHT:
+            case SDL_GAMEPAD_BUTTON_GUIDE:
+                return true;
+            default:
+                break;
+        }
+    }
+
+    if (event->type == SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+        static bool l2=false, r2=false;
+        const bool pressed=event->gaxis.value > 16384;
+        if (event->gaxis.axis == SDL_GAMEPAD_AXIS_LEFT_TRIGGER) {
+            if (pressed != l2) {
+                l2=pressed;
+                io.AddKeyEvent(ImGuiKey_UpArrow, pressed);
+            }
+            return true;
+        }
+        if (event->gaxis.axis == SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) {
+            if (pressed != r2) {
+                r2=pressed;
+                io.AddKeyEvent(ImGuiKey_DownArrow, pressed);
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+extern "C" void Port_ImGui_RG34XXPulseHorizontal(int direction) {
+    if (!Port_RG34XX_SeamlessUi() || !sImGuiInited || !Port_DebugMenu_IsOpen())
+        return;
+    ImGuiIO& io=ImGui::GetIO();
+    ImGuiKey key=direction < 0 ? ImGuiKey_LeftArrow : ImGuiKey_RightArrow;
+    io.AddKeyEvent(key,true);
+    io.AddKeyEvent(key,false);
+}
