diff --git a/port/port_bios.c b/port/port_bios.c
index 4e9f7ea..e745180 100644
--- a/port/port_bios.c
+++ b/port/port_bios.c
@@ -64,6 +64,11 @@ u64 DivAndModCombined(s32 num, s32 denom) {
 #else
 
 static bool gQuitRequested = false;
+
+int Port_QuitRequested(void) {
+    return gQuitRequested ? 1 : 0;
+}
+
 static bool sFastForward = false;
 static int sFrameNum = 0;
 
@@ -338,8 +343,11 @@ static void Port_PumpEvents(void) {
         /* Forward every event to ImGui so its window/keyboard tracking
          * stays in sync. ImGui only consumes input when a widget is
          * actively hovered/focused; game input passes through. */
-        if (Port_RG34XX_HandleSystemEvent(&e))
+        if (Port_RG34XX_HandleSystemEvent(&e)) {
+            if (gQuitRequested)
+                return;
             continue;
+        }
         if (Port_ImGui_HandleRG34XXNav(&e))
             continue;
         Port_ImGui_HandleEvent(&e);
@@ -866,7 +874,7 @@ void VBlankIntrWait(void) {
         if (Port_ImGui_QuitConfirmed())
             gQuitRequested = true;
         if (gQuitRequested)
-            exit(0);
+            return;
         SDL_Delay(4); /* ~4ms: responsive UI without a busy spin */
     }
 
@@ -1161,10 +1169,13 @@ void VBlankIntrWait(void) {
         gQuitRequested = true;
 
     if (gQuitRequested) {
-        exit(0);
+        return;
     }
 
     Port_PumpEvents();
+    if (gQuitRequested) {
+        return;
+    }
     Port_UpdateInput();
     Port_TestInputTick(gMain.ticks);
 
