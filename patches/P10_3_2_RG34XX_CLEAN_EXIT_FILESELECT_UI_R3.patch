diff --git a/port/port_main.c b/port/port_main.c
index ccf803e..5d71b72 100644
--- a/port/port_main.c
+++ b/port/port_main.c
@@ -914,5 +914,21 @@ int main(int argc, char* argv[]) {
     Port_Config_CloseGamepads();
     SDL_DestroyWindow(window);
     SDL_Quit();
+
+    /*
+     * RG34XX seamless profile: every explicit subsystem shutdown above has
+     * completed. Directed D3 hardware evidence showed that the normal C/C++
+     * process-finalizer phase can fault only after this point. Bypass that
+     * post-main finalizer phase on this profile; other targets keep normal
+     * return semantics.
+     */
+    {
+        const char* rgSeamless = getenv("TMC_RG34XX_SEAMLESS");
+        if (rgSeamless && *rgSeamless && rgSeamless[0] != '0') {
+            fflush(NULL);
+            _Exit(0);
+        }
+    }
+
     return 0;
 }
